#
# ============================================================
# Target Platform (目标平台)
# ============================================================
#
CONFIG_TARGET_airoha=y
CONFIG_TARGET_airoha_an7581=y
CONFIG_TARGET_airoha_an7581_DEVICE_bell_xg-040g-md=y
CONFIG_ARCH_64BIT=y
CONFIG_aarch64=y
CONFIG_LINUX_6_12=y

#
# Kernel options (内核选项)
#
CONFIG_KERNEL_DEVPTS_MULTIPLE_INSTANCES=y
CONFIG_KERNEL_IP_MROUTE=y
CONFIG_KERNEL_IPV6_MROUTE=y

# ============================================================
# 一、硬件驱动
# ============================================================

# ---------- NPU 神经网络处理单元 ----------
# 为 Airoha EN7581 芯片启用 NPU 硬件加速固件，提升 AI 推理性能
CONFIG_DEFAULT_airoha-en7581-npu-firmware=y	# 默认预装airoha en7581 NPU固件
CONFIG_PACKAGE_airoha-en7581-npu-firmware=y	# 启用 Airoha EN7581 NPU (神经网络处理单元) 的固件
CONFIG_PACKAGE_luci-app-airoha-npu=y		# 启用 Luci 界面下的 Airoha NPU 管理应用程序
CONFIG_PACKAGE_luci-app-istorex=y		#istores安装

# ---------- 以太网 PHY ----------
CONFIG_PACKAGE_kmod-phy-airoha-en8811h=y	# 以太网 PHY 驱动 (2.5G 网口)

# ---------- I2C 总线 (传感器/外设通信) ----------
CONFIG_PACKAGE_kmod-i2c-an7581=y		# I2C 总线驱动 (传感器/外设通信)

# ---------- 温度传感器 ----------
CONFIG_PACKAGE_kmod-thermal-an7581=y		# MT7621 系列芯片专用温度传感器驱动（用于读取 CPU 温度）
CONFIG_PACKAGE_kmod-hwmon-core=y		# 硬件监控核心模块（所有温度/电压传感器依赖的基础库）

# ---------- GPIO & LED ----------
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y	# GPIO 按键热插拔支持
CONFIG_PACKAGE_kmod-leds-gpio=y			# GPIO LED 驱动

# ---------- 网络虚拟化 ----------
CONFIG_PACKAGE_kmod-macvlan=y			# 启用 macvlan 核心驱动，用于创建虚拟网卡（多拨、容器网络等）

# ---------- RAID 支持 (mdadm 依赖) ----------
CONFIG_PACKAGE_kmod-md-mod=y			# RAID 核心模块
CONFIG_PACKAGE_kmod-md-raid0=y			# RAID 0 支持
CONFIG_PACKAGE_kmod-md-raid1=y			# RAID 1 支持
CONFIG_PACKAGE_kmod-md-raid10=y			# RAID 10 支持
CONFIG_PACKAGE_mdadm=y				# RAID 管理工具

# ============================================================
# 二、USB 支持
# ============================================================
#
CONFIG_USB_SUPPORT=y				# USB 总开关
CONFIG_PACKAGE_kmod-usb-core=y			# USB 核心基础驱动
CONFIG_PACKAGE_kmod-usb2=y			# USB 2.0 支持
CONFIG_PACKAGE_kmod-usb3=y			# USB 3.0 支持
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y		# XHCI 主控制器驱动（USB 3.0 标准）
CONFIG_PACKAGE_kmod-usb-xhci-mtk=y		# MTK USB3 主控驱动
CONFIG_PACKAGE_kmod-usb-storage=y		# U盘/移动硬盘支持
CONFIG_PACKAGE_kmod-usb-storage-uas=y		# USB 高速 UAS 协议
CONFIG_PACKAGE_kmod-usb-storage-extras=y	# 额外 USB 存储协议支持

# ============================================================
# 三、文件系统 (USB 存储设备格式兼容)
# ============================================================
#
CONFIG_PACKAGE_kmod-fs-ext4=y			# EXT4 格式支持
CONFIG_PACKAGE_kmod-fs-vfat=y			# VFAT (FAT32) 文件系统支持
CONFIG_PACKAGE_kmod-fs-exfat=y			# exFAT 文件系统支持 (大文件 U 盘)
CONFIG_PACKAGE_kmod-fuse=y			# FUSE 虚拟文件系统
CONFIG_PACKAGE_ntfs-3g=y			# NTFS 完整读写
CONFIG_PACKAGE_kmod-nls-utf8=y			# UTF-8 中文编码
CONFIG_PACKAGE_kmod-lib-crc16=y			# CRC16 底层依赖库

# ---------- 文件系统工具 ----------
CONFIG_PACKAGE_blkid=y				# 块设备 UUID 识别工具
CONFIG_PACKAGE_lsblk=y				# 列出块设备信息工具
CONFIG_PACKAGE_e2fsprogs=y			# EXT2/EXT3/EXT4 文件系统工具
CONFIG_PACKAGE_block-mount=y			# 块设备自动挂载工具

# ============================================================
# 四、网络共享 (Samba4)
# ============================================================
#
CONFIG_PACKAGE_samba4-server=y			# Samba4 服务端：实现局域网文件/打印机共享核心服务
CONFIG_PACKAGE_luci-app-samba4=y		# Samba4 Web 插件：LuCI 界面可视化配置共享目录/权限
CONFIG_PACKAGE_autosamba=y			# 自动共享工具：插入 USB 设备后自动挂载并创建 Samba 共享
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y		# Samba4 中文语言包：Web 界面显示中文，便于操作

# ============================================================
# 五、防火墙 & NAT
# ============================================================
#

# ---------- 防火墙 (iptables/nftables) ----------
CONFIG_PACKAGE_kmod-ipt-core=y			# iptables 核心模块
CONFIG_PACKAGE_kmod-ipt-conntrack=y		# 连接跟踪
CONFIG_PACKAGE_kmod-ipt-nat=y			# NAT 转发（上网必备）
CONFIG_PACKAGE_kmod-nft-compat=y		# iptables/nftables 兼容层
CONFIG_PACKAGE_iptables-nft=y			# iptables 新后端
CONFIG_PACKAGE_xtables-legacy=y			# 传统 iptables 命令兼容
CONFIG_PACKAGE_xtables-nft=y			# nftables 新一代命令工具
CONFIG_PACKAGE_nftables=y			# nft 核心工具
CONFIG_PACKAGE_firewall4=y			# nftables 版防火墙（取代旧 firewall）
CONFIG_PACKAGE_kmod-nfnetlink=y			# netfilter netlink 通信接口
CONFIG_PACKAGE_kmod-nft-core=y			# nftables 核心内核模块
CONFIG_PACKAGE_kmod-nft-nat=y			# nftables NAT 支持

# ---------- 网络加速 (Flow Offloading) ----------
CONFIG_PACKAGE_kmod-nf-flow=y			# 网络流加速 (Flow Offloading 基础)
CONFIG_PACKAGE_kmod-nft-offload=y		# nftables 硬件转发加速 (依赖芯片支持)

# ---------- 全锥 NAT ----------
CONFIG_PACKAGE_kmod-ipt-fullconenat=y		# 全锥 NAT 内核模块
CONFIG_PACKAGE_iptables-mod-fullconenat=y	# 全锥 NAT 工具
CONFIG_PACKAGE_luci-app-fullconenat=y		# 全锥 NAT 网页设置

# ============================================================
# 六、网络协议栈
# ============================================================
#
CONFIG_PACKAGE_dnsmasq=y			# DNS + DHCP + TFTP 服务 (轻量级)
CONFIG_PACKAGE_ip-full=y			# ip 命令 (完整版，用于网络配置)
CONFIG_IPV6=y					# 全局 IPv6 支持 (内核选项)
CONFIG_DEFAULT_odhcp6c=y			# IPv6 DHCP 客户端
CONFIG_DEFAULT_odhcpd-ipv6only=y		# IPv6-only DHCP 服务器 (配合 dnsmasq)
CONFIG_PACKAGE_ethtool-full=y			# 查看接口速率、双工模式、自动协商状态
CONFIG_PACKAGE_umdns=y				# 本地 mDNS/zeroconf 支持（hostname.local 解析）

# ============================================================
# 七、PPPoE 拨号 (宽带上网)
# ============================================================
#
CONFIG_PACKAGE_ppp=y				# PPP 协议核心
CONFIG_PACKAGE_ppp-mod-pppoe=y			# PPPoE 拨号模块

# ============================================================
# 八、基础系统
# ============================================================
#
CONFIG_DEFAULT_base-files=y			# 基础文件系统
CONFIG_DEFAULT_busybox=y			# 精简版工具集 (几乎所有命令都靠它)
CONFIG_DEFAULT_ca-bundle=y			# 根证书集合 (HTTPS/wget/curl 必须)
CONFIG_DEFAULT_logd=y				# 系统日志守护进程
CONFIG_DEFAULT_procd=y				# init 系统 / 服务管理核心
CONFIG_DEFAULT_uci=y				# 配置系统 (/etc/config/*)
CONFIG_DEFAULT_urandom-seed=y			# 随机种子保存/恢复 (加密相关)
CONFIG_DEFAULT_urngd=y				# 用户空间 RNG 守护进程
CONFIG_DEFAULT_netifd=y				# 网络接口管理核心
CONFIG_DEFAULT_mtd=y				# Flash 操作工具
CONFIG_DEFAULT_fstools=y			# 文件系统挂载/检查工具
CONFIG_DEFAULT_block-mount=y			# 块设备挂载支持 (USB 盘等)
CONFIG_DEFAULT_libc=y				# C 标准库
CONFIG_DEFAULT_libgcc=y				# GCC 运行时库

# ---------- Flash & UBI ----------
CONFIG_PACKAGE_ubi-utils=y			# UBI 文件系统工具 (NAND Flash)
CONFIG_MTD_UBI=y				# UBI 支持 (NAND 分区管理)
CONFIG_UBIFS_FS=y				# UBIFS 文件系统支持
CONFIG_PACKAGE_kmod-mtd-rw=y			# MTD 分区临时写权限（用于 NAND/eMMC 恢复或刷写）

# ---------- U-Boot ----------
CONFIG_PACKAGE_uboot-envtools=y			# U-Boot 环境变量工具
CONFIG_PACKAGE_kmod-ubootenv-nvram=y		# U-Boot NVRAM 环境支持

# ---------- 系统工具 ----------
CONFIG_PACKAGE_uclient-fetch=y			# uclient HTTP 下载工具
CONFIG_PACKAGE_curl=y				# curl 网络请求工具
CONFIG_PACKAGE_wget-ssl=y			# wget SSL 版
CONFIG_PACKAGE_fwtool=y				# 固件工具 (签名/验证)

# ============================================================
# 九、包管理器 (apk)
# ============================================================
#
CONFIG_PACKAGE_apk=y				# apk 包管理器主程序
CONFIG_DEFAULT_apk-tools=y			# apk 工具集
CONFIG_PACKAGE_apk-mbedtls=y			# apk 使用 mbedTLS 加密库
CONFIG_DEFAULT_openwrt-keyring=y		# 签名验证密钥环 (apk 生态安全验证)

# ============================================================
# 十、SSH 远程管理
# ============================================================
#
CONFIG_PACKAGE_dropbear=y			# Dropbear SSH 服务端
CONFIG_DROPBEAR_SMALL_CODE=y			# 精简编译 (减小体积)
CONFIG_DROPBEAR_ED25519=y			# 启用 ED25519 加密算法
CONFIG_DROPBEAR_CURVE25519=y			# 启用 Curve25519 密钥交换

# ============================================================
# 十一、LuCI Web 界面
# ============================================================
#

# ---------- 核心 & 主题 ----------
CONFIG_PACKAGE_luci=y				# Web 管理界面核心
CONFIG_PACKAGE_luci-ssl=y			# LuCI HTTPS 安全访问支持
CONFIG_PACKAGE_luci-theme-argon=y		# Argon 主题 (默认使用)
CONFIG_PACKAGE_luci-app-argon-config=y		# Argon 主题设置页面
CONFIG_PACKAGE_luci-theme-bootstrap=y		# Bootstrap 主题 (备用)

# ---------- 语言 ----------
CONFIG_LUCI_LANG_zh_Hans=y			# LuCI 默认简体中文
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y		# LuCI 基础中文语言包
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y	# 防火墙界面中文语言包

# ============================================================
# 十二、代理软件 (暂不需要，已全部注释)
# ============================================================
#
# CONFIG_PACKAGE_luci-app-homeproxy=y		# HomeProxy LuCI 界面
# CONFIG_PACKAGE_luci-app-passwall=y		# PassWall LuCI 界面
# CONFIG_PACKAGE_xray-core=y			# Xray 核心 (V2Ray 下一代)
# CONFIG_PACKAGE_kmod-nft-tproxy=y		# nftables 透明代理支持 (TPROXY)
# CONFIG_PACKAGE_kmod-nf-socket=y		# netfilter socket 匹配 (用于透明代理)
# CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=y	# HomeProxy 中文语言包
# CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y	# PassWall 中文语言包

# ============================================================
# 十三、编译选项
# ============================================================
#
CONFIG_DEVEL=y					# 开发者模式 (启用高级编译选项)
CONFIG_CCACHE=y					# 启用 ccache 加速编译
CONFIG_CCACHE_DIR="/mnt/openwrt/ccache"		# ccache 缓存目录
